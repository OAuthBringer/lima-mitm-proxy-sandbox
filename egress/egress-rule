#!/usr/bin/env python3
"""Admin CLI for rules.json (run in the guest with sudo). The proxy hot-reloads the file.

  sudo egress-rule list
  sudo egress-rule allow|deny [-m METHODS] HOST [PATH_PREFIX]
  sudo egress-rule passthrough HOST
  sudo egress-rule forget [-m METHODS] HOST [PATH_PREFIX]

METHODS is a comma-separated list such as GET,HEAD. Without -m a rule matches any method.
A method-restricted rule applies only to requests the proxy decrypts. Use PATH_PREFIX "/" for
"any path" when you only want to restrict by method.
forget HOST removes every rule for the host; with PATH_PREFIX, every rule at that path; adding
-m narrows it to the rule with exactly those methods.
"""
import json
import os
import posixpath
import re
import sys
import urllib.parse

PATH = "/var/lib/egress/rules.json"
METHOD_RE = re.compile(r"^[A-Z][A-Z0-9_-]*$")


def norm_path(p):
    p = urllib.parse.unquote(urllib.parse.urlsplit(p).path).lower().rstrip("*")
    p = posixpath.normpath("/" + p.lstrip("/"))
    return p.rstrip("/") or "/"


def norm_methods(s):
    """Sorted unique upper-case list; None (any method) for empty or '*'. Bad names are an error:
    dropping one would silently widen the rule."""
    ms = sorted({m.strip().upper() for m in (s or "").split(",") if m.strip()})
    if not ms or "*" in ms:
        return None
    bad = [m for m in ms if not METHOD_RE.match(m)]
    if bad:
        sys.exit(f"invalid HTTP method(s): {', '.join(bad)}")
    return ms


def load():
    try:
        return json.load(open(PATH))
    except FileNotFoundError:
        return {"version": 1, "rules": []}


def save(d):
    tmp = PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.chown(tmp, *[os.stat("/var/lib/egress")[i] for i in (4, 5)])
    os.replace(tmp, PATH)


def parse(argv):
    methods, rest, it = None, [], iter(argv)
    for a in it:
        if a in ("-m", "--methods"):
            methods = norm_methods(next(it, ""))
        elif a.startswith("--methods="):
            methods = norm_methods(a.split("=", 1)[1])
        else:
            rest.append(a)
    return methods, rest


def main(argv):
    if not argv or argv[0] not in ("list", "allow", "deny", "passthrough", "forget"):
        sys.exit(__doc__)
    cmd = argv[0]
    methods, args = parse(argv[1:])
    d = load()
    if cmd == "list":
        for r in d["rules"]:
            ms = f" [{','.join(r['methods'])}]" if r.get("methods") else ""
            print(f"{r['action']:<11} {r['host']}{r['path'] or ''}{ms}")
        print(f"{len(d['rules'])} rule(s)")
        return
    if not args or len(args) > 2:
        sys.exit(__doc__)
    if cmd == "passthrough" and methods:
        sys.exit("passthrough cannot be restricted by method: the proxy cannot see the method")
    host = args[0].lower().rstrip(".")
    path = norm_path(args[1]) if len(args) > 1 else None
    path = None if path == "/" else path
    if cmd == "forget":
        # no path: every rule for the host; a path: every rule at that path; -m: just that set
        d["rules"] = [r for r in d["rules"] if not (
            r["host"] == host and (len(args) == 1 or r["path"] == path)
            and (methods is None or r.get("methods") == methods))]
    else:
        d["rules"] = [r for r in d["rules"] if not (
            r["host"] == host and r["path"] == path and r.get("methods") == methods)]
        rule = {"action": cmd, "host": host, "path": path}
        if methods:
            rule["methods"] = methods
        d["rules"].append(rule)
    save(d)


main(sys.argv[1:])
